<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>口业</title>
    <style>
        @font-face {
            font-family: '汇文明朝体';
            src: url('./fonts/汇文明朝体.otf') format('opentype');
            font-weight: normal;
            font-style: normal;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            cursor: pointer;
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* 真实纸张纹理背景 */
        .paper {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background:
                radial-gradient(circle 5px at 8% 18%, rgba(120, 100, 70, 0.28) 0%, transparent 100%),
                radial-gradient(circle 4px at 23% 34%, rgba(130, 110, 80, 0.25) 0%, transparent 100%),
                radial-gradient(circle 3px at 67% 12%, rgba(140, 120, 90, 0.2) 0%, transparent 100%),
                radial-gradient(circle 6px at 45% 78%, rgba(120, 100, 70, 0.18) 0%, transparent 100%),
                radial-gradient(circle 4px at 82% 56%, rgba(135, 115, 85, 0.22) 0%, transparent 100%),
                radial-gradient(circle 5px at 15% 89%, rgba(125, 105, 75, 0.2) 0%, transparent 100%),
                radial-gradient(circle 3px at 91% 23%, rgba(145, 125, 95, 0.15) 0%, transparent 100%),
                radial-gradient(circle 5px at 38% 45%, rgba(118, 98, 68, 0.2) 0%, transparent 100%),
                radial-gradient(circle 4px at 72% 91%, rgba(132, 112, 82, 0.18) 0%, transparent 100%),
                radial-gradient(circle 6px at 52% 8%, rgba(115, 95, 65, 0.24) 0%, transparent 100%),
                radial-gradient(circle 3px at 95% 67%, rgba(128, 108, 78, 0.2) 0%, transparent 100%),
                radial-gradient(circle 5px at 5% 62%, rgba(122, 102, 72, 0.26) 0%, transparent 100%),
                radial-gradient(circle 4px at 78% 38%, rgba(136, 116, 86, 0.18) 0%, transparent 100%),
                radial-gradient(circle 3px at 42% 95%, rgba(112, 92, 62, 0.22) 0%, transparent 100%),
                radial-gradient(circle 5px at 88% 82%, rgba(125, 105, 75, 0.2) 0%, transparent 100%),
                radial-gradient(circle 4px at 18% 52%, rgba(140, 120, 90, 0.16) 0%, transparent 100%),
                radial-gradient(circle 3px at 63% 28%, rgba(118, 98, 68, 0.25) 0%, transparent 100%),
                radial-gradient(circle 5px at 35% 62%, rgba(130, 110, 80, 0.2) 0%, transparent 100%),
                radial-gradient(circle 4px at 95% 45%, rgba(120, 100, 70, 0.22) 0%, transparent 100%),
                radial-gradient(circle 2px at 12% 15%, rgba(110, 90, 60, 0.3) 0%, transparent 100%),
                radial-gradient(circle 2px at 55% 67%, rgba(120, 100, 70, 0.25) 0%, transparent 100%),
                radial-gradient(circle 2px at 88% 44%, rgba(105, 85, 55, 0.28) 0%, transparent 100%),
                radial-gradient(circle 2px at 33% 92%, rgba(115, 95, 65, 0.22) 0%, transparent 100%),
                radial-gradient(circle 2px at 77% 8%, rgba(125, 105, 75, 0.2) 0%, transparent 100%),
                radial-gradient(circle 2px at 28% 72%, rgba(108, 88, 58, 0.26) 0%, transparent 100%),
                radial-gradient(circle 2px at 62% 52%, rgba(132, 112, 82, 0.2) 0%, transparent 100%),
                radial-gradient(circle 2px at 48% 18%, rgba(118, 98, 68, 0.24) 0%, transparent 100%),
                radial-gradient(circle 2px at 85% 95%, rgba(140, 120, 90, 0.18) 0%, transparent 100%),
                radial-gradient(circle 2px at 3% 38%, rgba(125, 105, 75, 0.22) 0%, transparent 100%),
                radial-gradient(circle 2px at 58% 88%, rgba(112, 92, 62, 0.2) 0%, transparent 100%),
                radial-gradient(circle 2px at 93% 12%, rgba(135, 115, 85, 0.19) 0%, transparent 100%),
                radial-gradient(circle 2px at 15% 48%, rgba(120, 100, 70, 0.25) 0%, transparent 100%),
                radial-gradient(circle 2px at 73% 73%, rgba(128, 108, 78, 0.21) 0%, transparent 100%),
                radial-gradient(circle 2px at 42% 35%, rgba(115, 95, 65, 0.23) 0%, transparent 100%),
                radial-gradient(circle 2px at 98% 58%, rgba(122, 102, 72, 0.17) 0%, transparent 100%),
                radial-gradient(circle 1px at 5% 5%, rgba(100, 80, 50, 0.35) 0%, transparent 100%),
                radial-gradient(circle 1px at 18% 28%, rgba(115, 95, 65, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 35% 12%, rgba(105, 85, 55, 0.32) 0%, transparent 100%),
                radial-gradient(circle 1px at 50% 50%, rgba(120, 100, 70, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 68% 35%, rgba(110, 90, 60, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 82% 18%, rgba(125, 105, 75, 0.26) 0%, transparent 100%),
                radial-gradient(circle 1px at 95% 82%, rgba(108, 88, 58, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 8% 75%, rgba(118, 98, 68, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 25% 58%, rgba(130, 110, 80, 0.25) 0%, transparent 100%),
                radial-gradient(circle 1px at 45% 85%, rgba(115, 95, 65, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 60% 5%, rgba(122, 102, 72, 0.27) 0%, transparent 100%),
                radial-gradient(circle 1px at 75% 48%, rgba(105, 85, 55, 0.32) 0%, transparent 100%),
                radial-gradient(circle 1px at 90% 65%, rgba(118, 98, 68, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 12% 42%, rgba(135, 115, 85, 0.24) 0%, transparent 100%),
                radial-gradient(circle 1px at 38% 68%, rgba(110, 90, 60, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 55% 25%, rgba(125, 105, 75, 0.26) 0%, transparent 100%),
                radial-gradient(circle 1px at 72% 82%, rgba(120, 100, 70, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 88% 38%, rgba(112, 92, 62, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 28% 8%, rgba(128, 108, 78, 0.25) 0%, transparent 100%),
                radial-gradient(circle 1px at 48% 42%, rgba(118, 98, 68, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 65% 62%, rgba(130, 110, 80, 0.24) 0%, transparent 100%),
                radial-gradient(circle 1px at 85% 92%, rgba(115, 95, 65, 0.27) 0%, transparent 100%),
                radial-gradient(circle 1px at 2% 95%, rgba(122, 102, 72, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 32% 22%, rgba(108, 88, 58, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 52% 72%, rgba(125, 105, 75, 0.26) 0%, transparent 100%),
                radial-gradient(circle 1px at 78% 12%, rgba(118, 98, 68, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 98% 28%, rgba(132, 112, 82, 0.24) 0%, transparent 100%),
                radial-gradient(circle 1px at 15% 82%, rgba(110, 90, 60, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 42% 5%, rgba(120, 100, 70, 0.26) 0%, transparent 100%),
                radial-gradient(circle 1px at 58% 48%, rgba(128, 108, 78, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 82% 75%, rgba(115, 95, 65, 0.27) 0%, transparent 100%),
                radial-gradient(circle 1px at 92% 8%, rgba(122, 102, 72, 0.25) 0%, transparent 100%),
                radial-gradient(circle 1px at 22% 95%, rgba(118, 98, 68, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 68% 18%, rgba(105, 85, 55, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 8% 58%, rgba(130, 110, 80, 0.24) 0%, transparent 100%),
                radial-gradient(circle 1px at 35% 78%, rgba(112, 92, 62, 0.3) 0%, transparent 100%),
                radial-gradient(circle 1px at 55% 38%, rgba(120, 100, 70, 0.26) 0%, transparent 100%),
                radial-gradient(circle 1px at 75% 58%, rgba(135, 115, 85, 0.28) 0%, transparent 100%),
                radial-gradient(circle 1px at 95% 48%, rgba(118, 98, 68, 0.25) 0%, transparent 100%),
                radial-gradient(ellipse 600px 400px at 30% 40%, rgba(160, 140, 100, 0.06) 0%, transparent 70%),
                radial-gradient(ellipse 500px 350px at 70% 60%, rgba(150, 130, 95, 0.05) 0%, transparent 70%),
                radial-gradient(ellipse 400px 500px at 50% 80%, rgba(155, 135, 100, 0.04) 0%, transparent 60%),
                repeating-linear-gradient(45deg, transparent, transparent 18px, rgba(160, 140, 100, 0.025) 18px, rgba(160, 140, 100, 0.025) 19px),
                repeating-linear-gradient(-45deg, transparent, transparent 22px, rgba(150, 130, 90, 0.02) 22px, rgba(150, 130, 90, 0.02) 23px),
                repeating-linear-gradient(90deg, transparent, transparent 8px, rgba(170, 150, 110, 0.025) 8px, rgba(170, 150, 110, 0.025) 9px),
                repeating-linear-gradient(0deg, transparent, transparent 6px, rgba(165, 145, 105, 0.03) 6px, rgba(165, 145, 105, 0.03) 7px),
                repeating-linear-gradient(90deg, transparent, transparent 40px, rgba(160, 140, 100, 0.04) 40px, rgba(160, 140, 100, 0.04) 41px),
                repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(180, 160, 120, 0.035) 2px, rgba(180, 160, 120, 0.035) 3px),
                radial-gradient(ellipse 200px 280px at 85% 15%, rgba(145, 115, 65, 0.1) 0%, transparent 65%),
                radial-gradient(ellipse 300px 200px at 15% 20%, rgba(150, 120, 70, 0.15) 0%, transparent 70%),
                radial-gradient(ellipse 250px 350px at 80% 75%, rgba(140, 110, 60, 0.12) 0%, transparent 70%),
                radial-gradient(ellipse 500px 400px at 50% 50%, rgba(170, 150, 100, 0.08) 0%, transparent 80%),
                radial-gradient(ellipse at center, transparent 50%, rgba(100, 80, 50, 0.25) 100%),
                linear-gradient(170deg, #e8dcc8 0%, #ddd0b8 30%, #e2d5bf 60%, #d8cbb2 100%);
        }

        .paper::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background:
                url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n1'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n1)' opacity='0.05'/%3E%3C/svg%3E"),
                url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n2'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n2)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        .paper::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background:
                linear-gradient(90deg, transparent 49.5%, rgba(0,0,0,0.03) 49.8%, rgba(255,255,255,0.02) 50.2%, transparent 50.5%),
                linear-gradient(0deg, transparent 49.5%, rgba(0,0,0,0.02) 49.8%, rgba(255,255,255,0.015) 50.2%, transparent 50.5%),
                linear-gradient(35deg, transparent 48%, rgba(0,0,0,0.008) 49%, rgba(255,255,255,0.005) 51%, transparent 52%),
                linear-gradient(-25deg, transparent 47%, rgba(0,0,0,0.006) 48.5%, rgba(255,255,255,0.004) 51.5%, transparent 53%);
            pointer-events: none;
        }

        .content {
            position: relative;
            z-index: 1;
            max-width: 920px;
            padding: 60px 40px;
            text-align: center;
            user-select: none;
        }

        .quote-text {
            font-family: "汇文明朝体", "KaiTi", "STKaiti", "楷体", serif;
            font-size: 26px;
            font-weight: bold;
            color: #3a3020;
            line-height: 2.8;
            letter-spacing: 4px;
        }

        .quote-text .char {
            display: inline;
            transition: none;
        }

        .quote-text .cursor {
            display: inline-block;
            width: 2px;
            height: 1.2em;
            background: #3a3020;
            margin-left: 2px;
            vertical-align: text-bottom;
            animation: blink 0.8s step-end infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        .source {
            font-family: "FangSong", "STFangsong", "仿宋", serif;
            font-size: 17px;
            color: #6a5a40;
            margin-top: 40px;
            letter-spacing: 3px;
            opacity: 0;
            transition: opacity 1.5s ease;
        }

        .source.visible {
            opacity: 1;
        }

        /* 崩塌中的字 */
        .char.falling {
            position: fixed;
            display: inline-block;
            will-change: transform, opacity;
        }

        /* 标题态的口業 */
        .char.special {
            position: fixed;
            display: inline-block;
            will-change: transform;
        }

        .title-link {
            display: inline-block;
            text-decoration: none;
            color: inherit;
            cursor: pointer;
            position: relative;
        }

        .title-link::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 50%;
            width: 0;
            height: 2px;
            background: #3a3020;
            transition: width 0.6s ease, left 0.6s ease;
        }

        .title-link:hover::after {
            width: 100%;
            left: 0;
        }

        .click-hint {
            position: fixed;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            font-family: "FangSong", "STFangsong", "仿宋", serif;
            font-size: 14px;
            color: #6a5a40;
            opacity: 0;
            transition: opacity 1s ease;
            letter-spacing: 3px;
            pointer-events: none;
            z-index: 2;
        }

        .click-hint.visible {
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="paper"></div>

    <div class="content">
        <div class="quote-text" id="quoteText"></div>
        <div class="source" id="source">——《受三皈五戒八戒斋文》</div>
    </div>

    <div class="click-hint" id="clickHint">点击屏幕任意处</div>

    <script>
    (function() {
        var line1 = '我弟子某甲，從今盡形不殺、不盜、不邪婬，是身善業；';
        var line2 = '不妄言、兩舌、不惡口、綺語，是口善業；';
        var line3 = '不嫉妒、瞋恚、娇慢、邪見，是意善業。';
        var text = line1 + line2 + line3;
        var breakAt = [line1.length, line1.length + line2.length];

        // "是口善業" 中的 "口" 和 "業" 在全文字符中的索引
        // line1.length = 25, line2 中 "是口善業" 的 "口" 位于第15位(0-indexed:14), "業" 位于第17位(0-indexed:16)
        var specialChars = {};
        specialChars[line1.length + 14] = '口'; // "是口善業" 的 "口"
        specialChars[line1.length + 16] = '業'; // "是口善業" 的 "業"

        var container = document.getElementById('quoteText');
        var sourceEl = document.getElementById('source');
        var clickHint = document.getElementById('clickHint');
        var i = 0;
        var charSpans = [];
        var typingDone = false;
        var collapsed = false;

        // 光标
        var cursor = document.createElement('span');
        cursor.className = 'cursor';
        container.appendChild(cursor);

        function typeNext() {
            if (i < text.length) {
                var span = document.createElement('span');
                span.className = 'char';
                span.textContent = text[i];
                if (specialChars.hasOwnProperty(i)) {
                    span.dataset.special = specialChars[i];
                }
                container.insertBefore(span, cursor);
                charSpans.push(span);
                i++;

                if (breakAt.indexOf(i) !== -1) {
                    var br = document.createElement('br');
                    container.insertBefore(br, cursor);
                    charSpans.push(br);
                }

                var delay = '，；。、'.indexOf(text[i - 1]) !== -1 ? 200 : 80;
                setTimeout(typeNext, delay);
            } else {
                setTimeout(function() {
                    cursor.style.display = 'none';
                    sourceEl.classList.add('visible');
                    typingDone = true;
                    clickHint.classList.add('visible');
                }, 600);
            }
        }

        setTimeout(typeNext, 1500);

        // 缓动函数：easeOutCubic
        function easeOutCubic(t) {
            return 1 - Math.pow(1 - t, 3);
        }

        function easeOutBack(t) {
            var c1 = 1.70158;
            var c3 = c1 + 1;
            return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
        }

        function collapse() {
            if (!typingDone || collapsed) return;
            collapsed = true;
            clickHint.style.display = 'none';
            sourceEl.style.opacity = '0';
            sourceEl.style.transition = 'opacity 0.5s ease';

            var specialSpans = [];
            var fallingSpans = [];
            var w = window.innerWidth;
            var h = window.innerHeight;

            // 收集所有字符span
            for (var idx = 0; idx < charSpans.length; idx++) {
                var span = charSpans[idx];
                if (span.tagName === 'BR') {
                    span.style.display = 'none';
                    continue;
                }
                var rect = span.getBoundingClientRect();
                if (rect.width === 0 || rect.height === 0) continue;

                if (span.dataset.special) {
                    specialSpans.push({
                        el: span,
                        x: rect.left,
                        y: rect.top,
                        w: rect.width,
                        h: rect.height,
                        char: span.dataset.special
                    });
                } else {
                    fallingSpans.push({
                        el: span,
                        x: rect.left,
                        y: rect.top,
                        w: rect.width,
                        h: rect.height,
                        // 初始微小随机偏移和速度
                        vx: (Math.random() - 0.5) * 1.2,
                        vy: Math.random() * 0.5,
                        rot: 0,
                        vRot: (Math.random() - 0.5) * 2.5,
                        opacity: 1,
                        delay: Math.random() * 15 // 随机延迟启动，增加"有生命"感
                    });
                }
            }

            // 先把所有字固定到当前位置
            for (var f = 0; f < fallingSpans.length; f++) {
                var item = fallingSpans[f];
                item.el.classList.add('falling');
                item.el.style.left = item.x + 'px';
                item.el.style.top = item.y + 'px';
            }

            for (var s = 0; s < specialSpans.length; s++) {
                var sp = specialSpans[s];
                sp.el.classList.add('special');
                sp.el.style.left = sp.x + 'px';
                sp.el.style.top = sp.y + 'px';
            }

            // 物理模拟参数
            var gravity = 0.6;
            var airResistance = 0.995;
            var frame = 0;
            var animId;
            var allFallen = false;
            var specialAnimStart = 40; // 特殊字动画在N帧后开始

            // 特殊字的目标位置和动画参数
            var targetX = w / 2;
            var targetY = h / 2;
            var specialAnimDuration = 120; // 帧数

            // 计算特殊字原始位置的中心
            var specialCenterX, specialCenterY;
            if (specialSpans.length === 2) {
                specialCenterX = (specialSpans[0].x + specialSpans[1].x + specialSpans[0].w + specialSpans[1].w) / 2;
                specialCenterY = (specialSpans[0].y + specialSpans[1].y + specialSpans[0].h + specialSpans[1].h) / 2;
            } else {
                specialCenterX = w / 2;
                specialCenterY = h / 2;
            }

            function step() {
                frame++;
                var allDone = true;

                // 下落字物理模拟
                for (var fi = 0; fi < fallingSpans.length; fi++) {
                    var item = fallingSpans[fi];
                    if (frame < item.delay) {
                        allDone = false;
                        continue;
                    }
                    if (item.opacity <= 0) continue;

                    item.vy += gravity;
                    item.vx *= airResistance;
                    item.x += item.vx;
                    item.y += item.vy;
                    item.rot += item.vRot;

                    // 透明度逐渐降低
                    if (item.y > h * 0.4) {
                        item.opacity -= 0.008;
                        if (item.opacity < 0) item.opacity = 0;
                    }

                    if (item.opacity > 0) {
                        allDone = false;
                        item.el.style.transform = 'translate(' + (item.x - parseFloat(item.el.style.left)) + 'px, ' + (item.y - parseFloat(item.el.style.top)) + 'px) rotate(' + item.rot + 'deg)';
                        item.el.style.opacity = item.opacity;
                    } else {
                        item.el.style.opacity = '0';
                        item.el.style.display = 'none';
                    }
                }

                // 特殊字动画：缓缓移到中间，渐渐变大
                if (frame >= specialAnimStart) {
                    var specialProgress = Math.min(1, (frame - specialAnimStart) / specialAnimDuration);
                    var ease = easeOutCubic(specialProgress);
                    var easeB = easeOutBack(specialProgress);

                    var totalSpecialWidth = specialSpans.reduce(function(acc, sp) { return acc + sp.w; }, 0);
                    var startX = targetX - totalSpecialWidth / 2;

                    var currentX = startX;
                    for (var si = 0; si < specialSpans.length; si++) {
                        var sp = specialSpans[si];
                        var fromX = sp.x;
                        var fromY = sp.y;
                        var toX = currentX;
                        var toY = targetY - sp.h / 2;

                        var nowX = fromX + (toX - fromX) * ease;
                        var nowY = fromY + (toY - fromY) * ease;
                        var scale = 1 + (4 - 1) * easeB; // 放大到4倍

                        sp.el.style.transform = 'translate(' + (nowX - sp.x) + 'px, ' + (nowY - sp.y) + 'px) scale(' + scale + ')';
                        sp.el.style.zIndex = '10';

                        currentX += sp.w * scale;
                    }
                }

                if (!allDone) {
                    animId = requestAnimationFrame(step);
                } else {
                    // 所有下落字消失，特殊字变成可点击标题
                    finalizeTitle();
                }
            }

            function finalizeTitle() {
                // 清除多余元素，只保留口和業
                for (var ci = 0; ci < charSpans.length; ci++) {
                    var el = charSpans[ci];
                    if (el.tagName === 'BR') {
                        el.remove();
                        continue;
                    }
                    if (!el.dataset.special) {
                        el.remove();
                    }
                }

                // 创建一个包裹链接
                var link = document.createElement('a');
                link.className = 'title-link';
                link.href = './content.html';

                // 移动口和業到link中
                for (var si2 = 0; si2 < specialSpans.length; si2++) {
                    var sp2 = specialSpans[si2];
                    var rect2 = sp2.el.getBoundingClientRect();
                    sp2.el.style.left = rect2.left + 'px';
                    sp2.el.style.top = rect2.top + 'px';
                    sp2.el.style.transform = 'none';
                    link.appendChild(sp2.el);
                }

                // 将link放入container
                container.innerHTML = '';
                container.appendChild(link);

                // 重新定位到居中
                link.style.display = 'inline-flex';
                link.style.alignItems = 'center';
                link.style.justifyContent = 'center';
                link.style.gap = '0.1em';
                link.style.fontSize = '120px';
                link.style.color = '#3a3020';
                link.style.fontFamily = '"汇文明朝体", "KaiTi", "STKaiti", "楷体", serif';
                link.style.fontWeight = 'bold';
                link.style.letterSpacing = '0.15em';
                link.style.position = 'fixed';
                link.style.top = '50%';
                link.style.left = '50%';
                link.style.transform = 'translate(-50%, -50%)';

                // 给特殊字移除fixed定位
                for (var si3 = 0; si3 < specialSpans.length; si3++) {
                    var sp3 = specialSpans[si3];
                    sp3.el.style.position = 'static';
                    sp3.el.style.left = '';
                    sp3.el.style.top = '';
                    sp3.el.style.willChange = '';
                    sp3.el.style.zIndex = '';
                }
            }

            animId = requestAnimationFrame(step);
        }

        document.body.addEventListener('click', collapse);
        document.body.addEventListener('touchstart', function(e) {
            e.preventDefault();
            collapse();
        }, { once: true });
    })();
    </script>
</body>
</html>
