                    0deg,
                    transparent,
                    transparent 6px,
                    rgba(165, 145, 105, 0.03) 6px,
                    rgba(165, 145, 105, 0.03) 7px
                ),
                /* 层7: 纤维纹理 - 稀疏竖纹 */
                repeating-linear-gradient(
                    90deg,
                    transparent,
                    transparent 40px,
                    rgba(160, 140, 100, 0.04) 40px,
                    rgba(160, 140, 100, 0.04) 41px
                ),
                /* 层6: 纤维纹理 - 细密横纹 */
                repeating-linear-gradient(
                    0deg,
                    transparent,
                    transparent 2px,
                    rgba(180, 160, 120, 0.035) 2px,
                    rgba(180, 160, 120, 0.035) 3px
