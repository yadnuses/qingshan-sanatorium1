                    transparent,
                    transparent 22px,
                    rgba(150, 130, 90, 0.02) 22px,
                    rgba(150, 130, 90, 0.02) 23px
                ),
                /* 层9: 纤维纹理 - 中等密度竖纹 */
                repeating-linear-gradient(
                    90deg,
                    transparent,
                    transparent 8px,
                    rgba(170, 150, 110, 0.025) 8px,
                    rgba(170, 150, 110, 0.025) 9px
                ),
                /* 层8: 纤维纹理 - 中等密度横纹 */
