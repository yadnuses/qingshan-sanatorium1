                /* 层2: 污渍 - 中心泛黄 */
                radial-gradient(ellipse 500px 400px at 50% 50%, rgba(170, 150, 100, 0.08) 0%, transparent 80%),
                /* 层1: 边缘暗角 */
                radial-gradient(ellipse at center, transparent 50%, rgba(100, 80, 50, 0.25) 100%),
                /* 层0: 基础底色 - 泛黄 */
                linear-gradient(170deg, #e8dcc8 0%, #ddd0b8 30%, #e2d5bf 60%, #d8cbb2 100%);
