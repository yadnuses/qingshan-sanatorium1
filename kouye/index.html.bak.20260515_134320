        /* 纸张纤维 - 双层 SVG 噪点 */
        .paper::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background:
                /* 粗噪点 - 模拟纸浆颗粒 */
                url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n1'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n1)' opacity='0.05'/%3E%3C/svg%3E"),
                /* 细噪点 - 模拟纤维表面 */
                url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n2'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n2)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
        }

        /* 折痕与细微褶皱 */
        .paper::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background:
                /* 主折痕 - 横向 */
                linear-gradient(90deg, transparent 49.5%, rgba(0,0,0,0.03) 49.8%, rgba(255,255,255,0.02) 50.2%, transparent 50.5%),
                /* 主折痕 - 纵向 */
                linear-gradient(0deg, transparent 49.5%, rgba(0,0,0,0.02) 49.8%, rgba(255,255,255,0.015) 50.2%, transparent 50.5%),
                /* 细微褶皱 - 斜向 */
                linear-gradient(35deg, transparent 48%, rgba(0,0,0,0.008) 49%, rgba(255,255,255,0.005) 51%, transparent 52%),
                /* 细微褶皱 - 另一斜向 */
                linear-gradient(-25deg, transparent 47%, rgba(0,0,0,0.006) 48.5%, rgba(255,255,255,0.004) 51.5%, transparent 53%);
            pointer-events: none;
        }

        .content {
            position: relative;
            z-index: 1;
            max-width: 920px;
            padding: 60px 40px;
            text-align: center;
        }

        .quote-text {
            font-family: "汇文明朝体", "KaiTi", "STKaiti", "楷体", serif;
            font-size: 26px;
            font-weight: bold;
            color: #3a3020;
            line-height: 2.8;
            letter-spacing: 4px;
        }

        .quote-text .cursor {
            display: inline-block;
            width: 2px;
            height: 1.2em;
            background: #3a3020;
            margin-left: 2px;
            vertical-align: text-bottom;
            animation: blink 0.8s step-end infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        .source {
            font-family: "FangSong", "STFangsong", "仿宋", serif;
            font-size: 17px;
            color: #6a5a40;
            margin-top: 40px;
            letter-spacing: 3px;
            opacity: 0;
            transition: opacity 1.5s ease;
        }

        .source.visible {
            opacity: 1;
        }
    </style>
</head>
<body>
    <div class="paper"></div>

    <div class="content">
        <div class="quote-text" id="quoteText"></div>
        <div class="source" id="source">——《受三皈五戒八戒斋文》</div>
    </div>

    <script>
        var line1 = '我弟子某甲，從今盡形不殺、不盜、不邪婬，是身善業；';
        var line2 = '不妄言、兩舌、不惡口、綺語，是口善業；';
        var line3 = '不嫉妒、瞋恚、娇慢、邪見，是意善業。';
        var text = line1 + line2 + line3;
        var breakAt = [line1.length, line1.length + line2.length];
        var container = document.getElementById('quoteText');
        var sourceEl = document.getElementById('source');
        var i = 0;

        // 添加光标
        var cursor = document.createElement('span');
        cursor.className = 'cursor';
        container.appendChild(cursor);

        function typeNext() {
            if (i < text.length) {
                // 在光标前插入字符
                var charSpan = document.createTextNode(text[i]);
                container.insertBefore(charSpan, cursor);
                i++;

                // 换行
                if (breakAt.indexOf(i) !== -1) {
                    var br = document.createElement('br');
                    container.insertBefore(br, cursor);
                }

                // 标点符号后停顿稍长
                var delay = '，；。、'.indexOf(text[i - 1]) !== -1 ? 200 : 80;
                setTimeout(typeNext, delay);
            } else {
                // 打字完成，移除光标，显示出处
                setTimeout(function() {
                    cursor.style.display = 'none';
                    sourceEl.classList.add('visible');
                }, 600);
            }
        }

        // 延迟开始打字
        setTimeout(typeNext, 1500);
    </script>
</body>
